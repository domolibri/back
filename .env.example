# ==============================================================
# DomoLibri — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores antes de usar.
# NUNCA commite o arquivo .env no controle de versão.
# ==============================================================

# --------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# --------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=AdminPassword123!
DB_NAME=domolibri_db

# --------------------------------------------------------------
# JWT
# OBRIGATÓRIO: mínimo 32 caracteres
# --------------------------------------------------------------
JWT_SECRET=your_super_secret_key_at_least_32_characters_here!!

# --------------------------------------------------------------
# Frontend (CORS / links de e-mail)
# --------------------------------------------------------------
FRONTEND_URL=http://localhost:4200
ALLOWEDORIGINS=http://localhost:4200

# --------------------------------------------------------------
# E-mail (remetente)
# --------------------------------------------------------------
SMTP_SENDER_NAME=Domo Libri
SMTP_SENDER_EMAIL=no-reply@domolibri.com.br

# Mailpit — número máximo de mensagens em memória
MP_MAX_MESSAGES=500

# --------------------------------------------------------------
# Azure Blob Storage / Azurite
# URL pública usada nos links retornados pela API.
# No dev com Docker, aponta para o Azurite exposto no host.
# --------------------------------------------------------------
BLOB_PUBLIC_ENDPOINT=http://localhost:10000/devstoreaccount1

# --------------------------------------------------------------
# ASP.NET Core
# --------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
